# Copy to .env for local Podman/docker-compose use. Never commit the real .env file.

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

WORDPRESS_DB_HOST=db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0

# Plugins/themes are managed via composer.json only - disable wp-admin's
# plugin/theme install, delete, update and file-edit screens.
WORDPRESS_CONFIG_EXTRA=define('DISALLOW_FILE_MODS', true); define('DISALLOW_FILE_EDIT', true);

# Used by nginx's envsubst templating (see docker/nginx/templates/default.conf.template)
FASTCGI_HOST=wordpress
